/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-03-22",
	"main": "src/index.ts",
	"name": "serverless-openapi-worker",
	"upload_source_maps": true,
	"observability": {
		"enabled": true
	},
  // KV Namespace -bindaukset
  "kv_namespaces": [
    {
      "binding": "TASKS_KV",        // Koodi viittaa tähän nimellä `kv: KVNamespace`
      "id": "OPENAPI_KV_NAMESPACE"  // Vaihda tähän KV Namespace ID, jonka sait luodessasi KV:n
    }
  ],

  // Ympäristökohtaiset asetukset (valinnainen)
  "env": {
    "test": {
      "name": "serverless-openapi-worker-test",
      "kv_namespaces": [
        {
          "binding": "TASKS_KV",
          "id": "OPENAPI_KV_NAMESPACE"
        }
      ]
    }
  },

  "vars": {
    "ENVIRONMENT": "test"
  }	
}